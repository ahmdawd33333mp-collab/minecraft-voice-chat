<?xml version="1.0" encoding="utf-8"?>
<!-- App v6: black background, microphone image, white text. No floating
     overlay button anymore: voice is controlled from inside the game
     (/c, /cc, /s). Scrollable so the whole screen fits small phones. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="ميكروفون ماين كرافت"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold" />

    <ImageView
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginTop="24dp"
        android:src="@drawable/mic_bg"
        android:contentDescription="Microphone" />

    <EditText
        android:id="@+id/nameField"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:hint="اكتب اسمك"
        android:textColor="#FFFFFF"
        android:textColorHint="#AAAAAA"
        android:textSize="24sp"
        android:inputType="textPersonName" />

    <Button
        android:id="@+id/connectButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="16dp"
        android:text="اتصال"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="غير متصل"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <!-- Shown after connecting: the link is automatic by same name. -->
    <LinearLayout
        android:id="@+id/commandSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:visibility="gone"
        android:layout_marginTop="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ادخل اللعبة — الربط تلقائي بنفس الاسم"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/commandText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="/ahmdawd3"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/copyButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="نسخ الأمر" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="كم بلوك بدك يسمعوك الآخرين؟"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <Spinner
        android:id="@+id/rangeSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/speakingText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="يتكلم الآن: -"
        android:textColor="#FFFFFF" />

    <Switch
        android:id="@+id/autoSenseSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="تشغيل تلقائي مع ماينكرافت"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/permissionsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="الأذونات (مايك + الوصول للاستخدام)" />

    <Button
        android:id="@+id/batteryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="إعدادات البطارية (إذا توقفت الخدمة)" />

    <!-- Mic button, bottom-centre. Tap = mute/unmute, long-press = groups. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom|center_horizontal">

        <Button
            android:id="@+id/micButton"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:text="MIC ON&#10;اضغط للكتم"
            android:textSize="18sp" />
    </FrameLayout>

</LinearLayout>
</ScrollView>
