<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Microphone: captured by AudioRecord, only while the service runs. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Network: WebSocket to the relay only. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Foreground service that keeps mic + playback alive while playing. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Floating mute button drawn over Minecraft while playing. The user
         grants this once on the system overlay-permission screen; the app
         never draws anything without that grant. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Usage access: NOT granted by the app. The user grants it in Settings,
         which is the only way UsageStatsManager can see the foreground app.
         Declared here so the check in GameWatcher works; the grant itself
         happens on the Settings screen the app opens. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="true"
        android:label="VoiceChat"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".VoiceService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
